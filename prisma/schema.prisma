generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(ASSESSOR)
  mandateId    String
  createdAt    DateTime        @default(now())
  takeovers    HumanTakeover[]
  mandate      Mandate         @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId])
}

model Mandate {
  id                  String                   @id @default(cuid())
  name                String
  politicianName      String
  city                String
  state               String
  whatsappNumber      String
  aiPrompt            String
  createdAt           DateTime                 @default(now())
  aiActions           AIAction[]
  campaigns           Campaign[]
  campaignEventLogs   CampaignEventLog[]
  campaignSettings    CampaignSettings?
  categories          Category[]
  citizens            Citizen[]
  complianceLogs      ComplianceLog[]
  consentLogs         ConsentLog[]
  contacts            Contact[]
  conversations       Conversation[]
  demands             Demand[]
  takeovers           HumanTakeover[]
  messageQueues       MessageQueue[]
  templates           MessageTemplate[]
  reputationProfile   NumberReputationProfile?
  optOutEvents        OptOutEvent[]
  sendAttempts        SendAttempt[]
  suppressionList     SuppressionList[]
  trustRecoveryStates TrustRecoveryState[]
  users               User[]
  warmupRules         WarmupRule[]
  whatsappMessageLogs WhatsAppMessageLog[]
  whatsappTemplates   WhatsAppTemplate[]
  workerHeartbeats    WorkerHeartbeat[]
}

model Citizen {
  id            String         @id @default(cuid())
  name          String
  phone         String
  mandateId     String
  createdAt     DateTime       @default(now())
  mandate       Mandate        @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  demands       Demand[]

  @@unique([mandateId, phone])
  @@index([mandateId, phone])
}

model Conversation {
  id                          String             @id @default(cuid())
  citizenId                   String
  mandateId                   String
  status                      ConversationStatus @default(OPEN)
  lastMessageAt               DateTime
  createdAt                   DateTime           @default(now())
  aiPaused                    Boolean            @default(false)
  conversationWindowExpiresAt DateTime?
  currentQueue                String             @default("incoming-message")
  humanPriority               Boolean            @default(false)
  humanTakeoverActive         Boolean            @default(false)
  lastAIAction                AIActionType?
  lastComplianceCheckAt       DateTime?
  metaWindowOpen              Boolean            @default(true)
  operationalScore            Int                @default(100)
  riskScore                   Float              @default(0)
  sensitive                   Boolean            @default(false)
  spamRisk                    String             @default("LOW")
  aiActions                   AIAction[]
  complianceLogs              ComplianceLog[]
  citizen                     Citizen            @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  mandate                     Mandate            @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  demands                     Demand[]
  takeovers                   HumanTakeover[]
  messages                    Message[]
  messageQueues               MessageQueue[]

  @@index([mandateId, status, lastMessageAt])
  @@index([citizenId, createdAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  externalMessageId String?          @unique
  direction         MessageDirection
  content           String
  source            MessageSource
  createdAt         DateTime         @default(now())
  complianceStatus  ComplianceStatus @default(PENDING)
  deliveredAt       DateTime?
  failedAt          DateTime?
  providerMessageId String?
  queuedAt          DateTime?
  retryCount        Int              @default(0)
  sentAt            DateTime?
  failureReason     String?
  readAt            DateTime?
  aiActions         AIAction[]
  complianceLogs    ComplianceLog[]
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  queueEntries      MessageQueue[]

  @@index([conversationId, createdAt])
  @@index([source, createdAt])
  @@index([providerMessageId])
}

model Demand {
  id             String         @id @default(cuid())
  mandateId      String
  citizenId      String
  conversationId String
  title          String
  description    String
  categoryId     String
  status         DemandStatus   @default(NEW)
  priority       DemandPriority @default(MEDIUM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       Category       @relation(fields: [categoryId], references: [id])
  citizen        Citizen        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mandate        Mandate        @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId, status, priority])
  @@index([citizenId, createdAt])
  @@index([conversationId])
  @@index([categoryId])
}

model Category {
  id        String   @id @default(cuid())
  mandateId String
  name      String
  color     String
  createdAt DateTime @default(now())
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  demands   Demand[]

  @@unique([mandateId, name])
  @@index([mandateId, createdAt])
}

model ComplianceLog {
  id             String        @id @default(cuid())
  mandateId      String
  conversationId String?
  messageId      String?
  riskScore      Float
  spamRisk       String
  reason         String
  actionTaken    String
  metadata       Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  mandate        Mandate       @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id])

  @@index([mandateId, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId, createdAt])
}

model AIAction {
  id             String       @id @default(cuid())
  mandateId      String
  conversationId String
  messageId      String?
  actionType     AIActionType
  decision       String
  confidence     Float
  reason         String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mandate        Mandate      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id])

  @@index([mandateId, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId, createdAt])
}

model MessageQueue {
  id             String           @id @default(cuid())
  mandateId      String
  conversationId String?
  messageId      String?
  direction      MessageDirection
  status         QueueStatus      @default(QUEUED)
  scheduledFor   DateTime
  processedAt    DateTime?
  failedAt       DateTime?
  error          String?
  retryCount     Int              @default(0)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  priority       QueuePriority    @default(NORMAL)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id])
  mandate        Mandate          @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  message        Message?         @relation(fields: [messageId], references: [id])

  @@index([mandateId, status, scheduledFor])
  @@index([conversationId, createdAt])
  @@index([messageId, createdAt])
}

model HumanTakeover {
  id             String       @id @default(cuid())
  conversationId String
  userId         String?
  mandateId      String
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  reason         String
  active         Boolean      @default(true)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mandate        Mandate      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([conversationId, startedAt])
  @@index([userId, startedAt])
  @@index([mandateId, startedAt])
}

model MessageTemplate {
  id         String   @id @default(cuid())
  mandateId  String
  name       String
  category   String
  language   String
  templateId String   @unique
  content    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mandate    Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId, approved, createdAt])
}

model Contact {
  id                   String               @id @default(cuid())
  mandateId            String
  name                 String
  phone                String
  source               String
  optIn                Boolean              @default(false)
  optInAt              DateTime?
  optOutAt             DateTime?
  consentStatus        String               @default("PENDING")
  firstContactSentAt   DateTime?
  firstContactStatus   String?
  lastInboundAt        DateTime?
  blockedFromCampaigns Boolean              @default(false)
  tags                 String[]
  influenceScore       Int                  @default(0)
  influenceLevel       String?
  influenceReason      String?
  communityRole        String?
  neighborhood         String?
  city                 String?
  zone                 String?
  role                 String?
  interestArea         String?
  politicalTemperature String?
  relationshipType     String?
  nextAction           String?
  notes                String?
  lastInteractionAt    DateTime?
  relationshipStatus   String?
  relationshipScore    Int                  @default(0)
  status               ContactStatus        @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  birthday             DateTime?
  recipients           CampaignRecipient[]
  consentLogs          ConsentLog[]
  mandate              Mandate              @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  optOutEvents         OptOutEvent[]
  sendAttempts         SendAttempt[]
  suppressionEntries   SuppressionList[]
  messageLogs          WhatsAppMessageLog[]

  @@unique([mandateId, phone])
  @@index([mandateId, status, optIn])
  @@index([mandateId, consentStatus])
  @@index([mandateId, birthday])
  @@index([mandateId, createdAt])
  @@index([mandateId, influenceScore])
  @@index([mandateId, influenceLevel])
  @@index([mandateId, neighborhood, zone])
  @@index([mandateId, relationshipStatus])
}

model WhatsAppTemplate {
  id               String                   @id @default(cuid())
  mandateId        String
  name             String
  category         WhatsAppTemplateCategory
  language         String
  body             String
  metaTemplateName String
  status           WhatsAppTemplateStatus   @default(PENDING)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  campaigns        Campaign[]
  messageLogs      WhatsAppMessageLog[]
  mandate          Mandate                  @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@unique([mandateId, metaTemplateName, language])
  @@index([mandateId, status, createdAt])
}

model Campaign {
  id                    String                     @id @default(cuid())
  mandateId             String
  name                  String
  templateId            String
  segmentTags           String[]
  status                CampaignStatus             @default(DRAFT)
  dailyLimit            Int
  delaySeconds          Int
  scheduledAt           DateTime?
  sentCount             Int                        @default(0)
  failedCount           Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  campaignMode          CampaignMode               @default(TEST)
  mandate               Mandate                    @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  template              WhatsAppTemplate           @relation(fields: [templateId], references: [id])
  audienceConfig        CampaignAudienceConfig?
  eventLogs             CampaignEventLog[]
  operationState        CampaignOperationState?
  recipients            CampaignRecipient[]
  safetySimulations     CampaignSafetySimulation[]
  reputationAdjustments ReputationAdjustmentLog[]
  sendAttempts          SendAttempt[]
  messageLogs           WhatsAppMessageLog[]

  @@index([mandateId, status, createdAt])
  @@index([mandateId, campaignMode, status])
  @@index([templateId])
}

model NumberReputationProfile {
  id                  String                    @id @default(cuid())
  mandateId           String                    @unique
  phoneNumber         String
  reputationScore     Int                       @default(78)
  spamRisk            Int                       @default(18)
  deliveryHealth      Int                       @default(88)
  qualityRating       String                    @default("Estavel")
  trustLevel          String                    @default("Protegido")
  warmingStage        CampaignWarmupStage       @default(DAY_1)
  trendDelta          Int                       @default(4)
  activeThroughput    Int                       @default(18)
  safeThroughput      Int                       @default(28)
  humanizedDelayMin   Int                       @default(25)
  humanizedDelayMax   Int                       @default(90)
  blockRisk           Int                       @default(14)
  queuePressure       Int                       @default(32)
  lastEvaluatedAt     DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  mandate             Mandate                   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  adjustmentLogs      ReputationAdjustmentLog[]
  trustRecoveryStates TrustRecoveryState[]

  @@index([mandateId, updatedAt])
}

model WarmupRule {
  id              String              @id @default(cuid())
  mandateId       String
  dayNumber       Int
  label           String
  stage           CampaignWarmupStage
  dailyLimit      Int
  throughputCap   Int
  minDelaySeconds Int
  maxDelaySeconds Int
  pauseOnRisk     Int                 @default(70)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  mandate         Mandate             @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@unique([mandateId, dayNumber])
  @@index([mandateId, stage])
}

model CampaignAudienceConfig {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  tags               String[]
  groups             String[]
  priorities         String[]
  locations          String[]
  interests          String[]
  contactTypes       String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  birthdayMonthDay   String?
  selectedContactIds String[]
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignOperationState {
  id                 String                @id @default(cuid())
  campaignId         String                @unique
  pipelineStage      CampaignPipelineStage @default(QUEUED)
  riskScore          Int                   @default(18)
  spamProbability    Int                   @default(12)
  deliveryRate       Int                   @default(93)
  queuePressure      Int                   @default(28)
  activeThroughput   Int                   @default(16)
  safeThroughput     Int                   @default(24)
  currentDelayMin    Int                   @default(25)
  currentDelayMax    Int                   @default(90)
  sendingWindowStart Int                   @default(8)
  sendingWindowEnd   Int                   @default(20)
  cooldownMinutes    Int                   @default(12)
  failsafeTriggered  Boolean               @default(false)
  humanReviewNeeded  Boolean               @default(false)
  recommendedAction  String?
  pausedReason       String?
  lastEvaluatedAt    DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  campaign           Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([pipelineStage, updatedAt])
}

model CampaignEventLog {
  id                  String              @id @default(cuid())
  mandateId           String
  campaignId          String?
  campaignRecipientId String?
  level               OperationEventLevel @default(INFO)
  eventType           String
  title               String
  message             String
  recommendedAction   String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  campaign            Campaign?           @relation(fields: [campaignId], references: [id])
  campaignRecipient   CampaignRecipient?  @relation(fields: [campaignRecipientId], references: [id])
  mandate             Mandate             @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId, createdAt])
  @@index([campaignId, createdAt])
  @@index([campaignRecipientId, createdAt])
}

model CampaignSafetySimulation {
  id                         String            @id @default(cuid())
  campaignId                 String
  riskLevel                  CampaignRiskLevel
  safetyScore                Int
  recommendedDailyLimit      Int
  recommendedBatchSize       Int
  recommendedDelayMinSeconds Int
  recommendedDelayMaxSeconds Int
  recommendedStartTime       DateTime?
  requiresHumanReview        Boolean           @default(false)
  canStartNow                Boolean           @default(false)
  estimatedCompletionTime    String?
  estimatedReputationImpact  String?
  warnings                   Json?
  recommendations            Json?
  blockingReasons            Json?
  createdAt                  DateTime          @default(now())
  campaign                   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([riskLevel, createdAt])
}

model ReputationAdjustmentLog {
  id         String                  @id @default(cuid())
  profileId  String
  campaignId String?
  delta      Int
  reason     String
  severity   OperationEventLevel     @default(INFO)
  metadata   Json?
  createdAt  DateTime                @default(now())
  campaign   Campaign?               @relation(fields: [campaignId], references: [id])
  profile    NumberReputationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([campaignId, createdAt])
}

model TrustRecoveryState {
  id               String                  @id @default(cuid())
  profileId        String
  mandateId        String
  status           TrustRecoveryStatus     @default(ACTIVE)
  startedAt        DateTime                @default(now())
  endedAt          DateTime?
  reason           String
  recommendedLimit Int
  cooldownUntil    DateTime?
  recoverySteps    Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  mandate          Mandate                 @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  profile          NumberReputationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, updatedAt])
  @@index([mandateId, status, updatedAt])
}

model CampaignSettings {
  id                     String   @id @default(cuid())
  mandateId              String   @unique
  defaultDailyLimit      Int      @default(20)
  defaultDelaySeconds    Int      @default(60)
  maxConsecutiveFailures Int      @default(3)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  mandate                Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId])
}

model CampaignRecipient {
  id             String                  @id @default(cuid())
  campaignId     String
  contactId      String
  status         CampaignRecipientStatus @default(PENDING)
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  queuedAt       DateTime?
  messagePreview String?
  eventLogs      CampaignEventLog[]
  campaign       Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact        Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sendAttempts   SendAttempt[]
  messageLogs    WhatsAppMessageLog[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status, createdAt])
  @@index([contactId, status])
}

model OptOutEvent {
  id         String   @id @default(cuid())
  mandateId  String
  contactId  String
  keyword    String
  source     String
  rawMessage String
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  mandate    Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId, createdAt])
  @@index([contactId, createdAt])
}

model ConsentLog {
  id        String        @id @default(cuid())
  mandateId String
  contactId String?
  phone     String
  action    ConsentAction
  source    String
  reason    String?
  ipAddress String?
  userId    String?
  metadata  Json?
  createdAt DateTime      @default(now())
  contact   Contact?      @relation(fields: [contactId], references: [id])
  mandate   Mandate       @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId, phone, createdAt])
  @@index([contactId, createdAt])
  @@index([action, createdAt])
}

model SuppressionList {
  id        String   @id @default(cuid())
  mandateId String
  contactId String?
  phone     String
  reason    String
  source    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact? @relation(fields: [contactId], references: [id])
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@unique([mandateId, phone])
  @@index([mandateId, active, createdAt])
  @@index([contactId, active])
}

model SendAttempt {
  id                  String             @id @default(cuid())
  mandateId           String
  campaignId          String?
  campaignRecipientId String?
  contactId           String?
  phone               String
  template            String?
  status              SendAttemptStatus
  reason              String
  providerMessageId   String?
  queueRecordId       String?
  retryCount          Int                @default(0)
  metadata            Json?
  createdAt           DateTime           @default(now())
  campaign            Campaign?          @relation(fields: [campaignId], references: [id])
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id])
  contact             Contact?           @relation(fields: [contactId], references: [id])
  mandate             Mandate            @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId, createdAt])
  @@index([campaignId, createdAt])
  @@index([contactId, createdAt])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model WhatsAppMessageLog {
  id                  String                      @id @default(cuid())
  mandateId           String
  contactId           String?
  templateId          String?
  campaignId          String?
  campaignRecipientId String?
  direction           WhatsAppMessageLogDirection
  status              WhatsAppMessageLogStatus
  providerMessageId   String?
  phone               String
  errorMessage        String?
  payload             Json?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  createdAt           DateTime                    @default(now())
  campaign            Campaign?                   @relation(fields: [campaignId], references: [id])
  campaignRecipient   CampaignRecipient?          @relation(fields: [campaignRecipientId], references: [id])
  contact             Contact?                    @relation(fields: [contactId], references: [id])
  mandate             Mandate                     @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  template            WhatsAppTemplate?           @relation(fields: [templateId], references: [id])

  @@index([mandateId, createdAt])
  @@index([campaignId, createdAt])
  @@index([campaignRecipientId, createdAt])
  @@index([providerMessageId])
}

model WorkerHeartbeat {
  id         String   @id @default(cuid())
  mandateId  String?
  workerName String   @unique
  status     String   @default("online")
  note       String?
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mandate    Mandate? @relation(fields: [mandateId], references: [id])

  @@index([mandateId, workerName])
  @@index([lastSeenAt])
}

enum Role {
  ADMIN
  ASSESSOR
}

enum ConversationStatus {
  OPEN
  HUMAN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  WHATSAPP
  AI
  HUMAN
  TEMPLATE
}

enum AIActionType {
  RESPOND
  WAIT_HUMAN
  REQUEST_CONTEXT
  USE_TEMPLATE
  ESCALATE
  BLOCK
}

enum QueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  QUEUED
  SIMULATED_SENT
}

enum QueuePriority {
  LOW
  NORMAL
  HIGH
}

enum ComplianceStatus {
  PENDING
  APPROVED
  PACED
  ESCALATED
  BLOCKED
  FAILED
}

enum DemandStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum DemandPriority {
  LOW
  MEDIUM
  HIGH
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
  INVALID
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppTemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
  UNSUBSCRIBED
  CANCELLED
  QUEUED
}

enum CampaignMode {
  TEST
  FIRST_CONTACT
  BIRTHDAY
  AUDIENCE
}

enum CampaignWarmupStage {
  DORMANT
  DAY_1
  DAY_2
  DAY_3
  STABLE
  COOLDOWN
  PAUSED
}

enum CampaignPipelineStage {
  QUEUED
  WARMING
  SENDING
  THROTTLED
  PAUSED
  RISK_DETECTED
  HUMAN_REVIEW
  COMPLETED
}

enum CampaignRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CampaignRiskTrend {
  IMPROVING
  STABLE
  WORSENING
}

enum TrustRecoveryStatus {
  INACTIVE
  ACTIVE
  MONITORING
  RECOVERED
}

