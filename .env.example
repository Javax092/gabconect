# Banco de dados
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Autenticacao
# Use segredos longos, aleatorios e diferentes. Minimo recomendado: 32 caracteres.
JWT_SECRET="gere-um-segredo-longo-aleatorio-com-pelo-menos-32-caracteres"
AUTH_SECRET="gere-outro-segredo-longo-aleatorio-com-pelo-menos-32-caracteres"

# Aplicacao
APP_URL="https://seu-dominio.example.com"
NEXT_PUBLIC_DEMO_MODE="false"

# Filas
# Obrigatorio em producao.
REDIS_URL="redis://USER:PASSWORD@HOST:6379"

# IA
OPENAI_API_KEY="sk-proj..."

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN="defina-um-token-forte-para-validacao-do-webhook"
WHATSAPP_DRY_RUN="true"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_TEST_RECIPIENT_PHONE=""
WHATSAPP_TEST_BYPASS_SEND_GATE="false"
WHATSAPP_TEST_ALLOWED_NUMBERS="5592999999999"
INTERNAL_TEST_TOKEN=""
META_APP_SECRET=""
WHATSAPP_MASS_CAMPAIGN_ENABLED="false"
CAMPAIGN_TEST_BYPASS_BUSINESS_HOURS="false"
MASS_CAMPAIGN_TEST_LIMIT="3"
# Bypass ativo por padrão no código. Defina "false" para reativar opt-in/status/suppression list em campanhas.
SKIP_AUDIENCE_VALIDATION="true"
MAX_SENDS_PER_MINUTE="10"
MAX_SENDS_PER_HOUR="200"
MAX_SENDS_PER_DAY="500"
WHATSAPP_SEND_DELAY_MIN_SECONDS="25"
WHATSAPP_SEND_DELAY_MAX_SECONDS="90"
ALERT_ERROR_RATE_PERCENT="5"
ALERT_OPT_OUT_RATE_PERCENT="2"

# Seed local/homologacao
SEED_ADMIN_NAME="Administrador do Gabinete"
SEED_ADMIN_EMAIL="admin@gabinete.local"
SEED_ADMIN_PASSWORD="troque-esta-senha"
SEED_MANDATE_NAME="Gabinete"
SEED_POLITICIAN_NAME="Nome Publico"
SEED_MANDATE_CITY="Manaus"
SEED_MANDATE_STATE="AM"
SEED_WHATSAPP_NUMBER="+5500000000000"
SEED_AI_PROMPT="Voce e a assistente institucional do gabinete. Responda com clareza, acolhimento e objetividade."
SEED_INCLUDE_SAMPLE_DATA="false"
